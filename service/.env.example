# Synthetic local values only. Never put production credentials in this file.
# Copy to .env, replace every placeholder and never commit the copy.

# Embedded local default; no PostgreSQL server required. Use pglite://memory for
# a disposable database, or point DATABASE_URL at PostgreSQL for integration.
DATABASE_URL=pglite://./data/pglite
# DATABASE_URL=postgresql://postgres:change-me@127.0.0.1:5432/bitos_pay
PAY_DB_SCHEMA=pay

PAY_HOST=127.0.0.1
PAY_PORT=8788
PAY_PUBLIC_BASE_URL=http://127.0.0.1:8788
PAY_INVOICE_TTL_SECONDS=900
PAY_FEE_BPS=0

# Per-merchant defaults applied at seed time. Amounts are millisatoshis.
PAY_RISK_MAX_PAYMENT_MSAT=100000000
PAY_RISK_DAILY_VOLUME_MSAT=1000000000
PAY_RISK_MAX_PAYMENTS_PER_MINUTE=60

# 32 random bytes, base64. Encrypts webhook endpoint secrets at rest.
PAY_SECRET_KEY=change-me-base64-32-bytes

# Live Lightning is opt-in and fails closed. The default mock provider is
# sandbox-only. Choose one live provider: lnbits, blink or strike. Never enable
# live on a local or shared demo deployment.
PAY_LIGHTNING_PROVIDER=mock
PAY_LIVE_ENABLED=0

# Self-hosted LNbits + LND/CLN.
# PAY_LNBITS_URL=https://lnbits.example
# PAY_LNBITS_API_KEY=replace-with-a-live-key
# PAY_LNBITS_WEBHOOK_SECRET=replace-with-at-least-16-random-characters

# Blink GraphQL API. The webhook secret is the Svix signing secret (whsec_...)
# shown in the Callback Portal opened from the Blink Dashboard Callback
# Endpoints page. The callbackEndpointAdd mutation does not return it.
# PAY_BLINK_API_URL=https://api.blink.sv/graphql
# PAY_BLINK_API_KEY=replace-with-a-blink-api-key
# PAY_BLINK_WALLET_ID=replace-with-a-btc-wallet-id
# PAY_BLINK_WEBHOOK_SECRET=whsec_replace-with-the-svix-signing-secret

# Strike receive requests. The webhook secret is also set on the Strike
# subscription and signs the raw body with X-Webhook-Signature.
# PAY_STRIKE_API_URL=https://api.strike.me/v1
# PAY_STRIKE_API_KEY=replace-with-a-strike-api-key
# PAY_STRIKE_WEBHOOK_SECRET=replace-with-the-subscription-secret

# Optional: let `seed` issue a bp_live_ key. Requires the selected live settings.
# PAY_SEED_LIVEMODE=1

# Public reusable payment links; limits invoice creation per client IP/minute.
PAY_PAYMENT_LINK_RATE_LIMIT=20

PAY_SANDBOX_ENABLED=1
PAY_SANDBOX_TOKEN=change-me-sandbox-token

# Unauthenticated sandbox-only onboarding. Off by default; enable only on a
# controlled local or demo deployment. Limit is per client IP per hour.
PAY_ONBOARDING_ENABLED=0
PAY_ONBOARDING_MAX_PER_HOUR=5

# Reference merchant console. Session cookies are HttpOnly + SameSite=Strict.
# Set PAY_CONSOLE_COOKIE_SECURE=1 when serving over HTTPS.
PAY_CONSOLE_ENABLED=1
# sandbox (default), live, or both. "both" shows the Sandbox/Live toggle.
PAY_CONSOLE_MODE=sandbox
PAY_CONSOLE_COOKIE_SECURE=0
PAY_CONSOLE_SESSION_TTL_SECONDS=28800
# Local-only nsec signing. Off by default: the nsec stays in the worker, but a
# compromised page could still steal it. Prefer NIP-07.
PAY_CONSOLE_ALLOW_NSEC=0
# Optional NIP-46 relay. Remote sign-in is disabled when empty.
# PAY_CONSOLE_NOSTR_RELAY=wss://relay.example

PAY_WEBHOOK_MAX_ATTEMPTS=8
PAY_WEBHOOK_TIMEOUT_MS=5000
# Dual-signature window after rotating a webhook secret.
PAY_WEBHOOK_ROTATION_GRACE_SECONDS=86400
PAY_WEBHOOK_ALLOW_PRIVATE=1
PAY_WORKER_INTERVAL_MS=5000
PAY_AUTO_MIGRATE=0

# Browser origins allowed to call the JSON API (comma-separated exact origins).
# Leave empty to disable CORS. Example: PAY_CORS_ORIGINS=http://127.0.0.1:5173
PAY_CORS_ORIGINS=
